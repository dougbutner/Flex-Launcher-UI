# Server-only. Never prefix with VITE_ — that would bundle the secret into the client.
PINATA_JWT=
PINATA_GATEWAY=gateway.pinata.cloud

# Token contracts (XPR mainnet). token.proton::reg is tcontract@active, not the issuer.
# WebAuth request account is `flexlaunch` (valid eosio name).
VITE_FLEXFOREX_CONTRACT=for3x
VITE_EASYFLEX=3asy
VITE_COMPLEXFLEX=fl3x
VITE_SWAP_ALCOR=swap.alcor

# Optional path for the issuer Manager sqlite file (vite dev / preview).
# MANAGER_SQLITE=data/manager.sqlite

# Admin listing PRs from dougbutner forks of alcor-ui and eos-airdrops. Never prefix with VITE_.
# GITHUB_TOKEN needs repo scope on dougbutner.
# GITHUB_TOKEN=
# GITHUB_LOGIN=dougbutner
