# Server-only. Never prefix with VITE_ — that would bundle the secret into the client.
PINATA_JWT=
PINATA_GATEWAY=gateway.pinata.cloud

# Token contracts (XPR mainnet). Logo reg on token.proton is tcontract@active.
# WebAuth request account is `flexlaunch` (valid eosio name).
VITE_FLEXFOREX_CONTRACT=for3x
VITE_EASYFLEX=3asy
VITE_COMPLEXFLEX=fl3x
VITE_SWAP_ALCOR=swap.alcor
