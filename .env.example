# Server-only. Never prefix with VITE_ — that would bundle the secret into the client.
PINATA_JWT=
PINATA_GATEWAY=gateway.pinata.cloud

# Token contracts (mainnet defaults). Logo reg on token.proton is tcontract@active.
VITE_FLEXFOREX_CONTRACT=flex.mon3y
VITE_EASYFLEX=mon3y
VITE_COMPLEXFLEX=gold.mon3y
VITE_SWAP_ALCOR=swap.alcor
